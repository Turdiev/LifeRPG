{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "life-rpg",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Placeholder: the real Hyperdrive id is created and set at stage 7 (release),
      // with query caching disabled (`wrangler hyperdrive create ... --caching-disabled`).
      "id": "00000000000000000000000000000000",
      // Local Docker PostgreSQL from docker-compose.yml (not a secret).
      "localConnectionString": "postgres://postgres:postgres@127.0.0.1:5432/life_rpg"
    }
  ]
}
