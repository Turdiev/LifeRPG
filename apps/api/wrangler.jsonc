{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "life-rpg",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Значения задаёт автор: локально — apps/api/.dev.vars (образец .dev.vars.example), в проде — wrangler secret put.
  "secrets": {
    "required": ["BETTER_AUTH_URL", "BETTER_AUTH_SECRET", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET"]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Заглушка: настоящий id Hyperdrive создаётся и прописывается на этапе 7 (выпуск),
      // с отключённым кешем запросов (`wrangler hyperdrive create ... --caching-disabled`).
      "id": "00000000000000000000000000000000",
      // Локальный PostgreSQL в Docker из docker-compose.yml (не секрет).
      "localConnectionString": "postgres://postgres:postgres@127.0.0.1:5432/life_rpg"
    }
  ]
}
