{
  "name": "life-rpg",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm db:up && pnpm --parallel --filter \"./apps/*\" dev",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @life-rpg/api db:generate",
    "db:migrate": "pnpm --filter @life-rpg/api db:migrate",
    "db:seed": "docker compose exec -T postgres psql -U postgres -d life_rpg -v ON_ERROR_STOP=1 < apps/api/src/db/seed-dev.sql",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
